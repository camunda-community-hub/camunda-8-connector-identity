<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.camunda.connector</groupId>
  <artifactId>connector-identity</artifactId>
  <!-- 1.0.0 First release -->
  <!-- 1.0.1 Move Move env to secrets.NEXUS_USR, secrets.NEXUS_PSW -->
  <version>1.0.1</version>

  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>23</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


    <!-- Camunda 8 connector SDK / runtime version - keep every io.camunda.connector artifact on
         this same version, otherwise the Spring Boot runtime mixes incompatible classes
         (e.g. NoClassDefFoundError on io.camunda.connector.feel.FeelEngineWrapper) -->
    <version.connector>8.10.0</version.connector>

    <!-- external libraries -->
    <version.assertj>3.25.3</version.assertj>
    <version.junit-jupiter>5.10.2</version.junit-jupiter>
    <version.mockito>5.11.0</version.mockito>
    <version.slf4j>2.0.12</version.slf4j>
    <!-- Must satisfy jackson-module-scala (pulled in by the connector runtime's FEEL evaluator),
         which requires jackson-databind >= 2.22.0 and < 2.23.0 -->
    <version.jackson>2.22.2</version.jackson>

    <!-- maven plugins -->
    <plugin.version.maven-clean-plugin>3.3.2</plugin.version.maven-clean-plugin>
    <plugin.version.maven-compiler-plugin>3.13.0</plugin.version.maven-compiler-plugin>
    <plugin.version.maven-dependency-plugin>3.6.1</plugin.version.maven-dependency-plugin>
    <plugin.version.maven-install-plugin>3.1.1</plugin.version.maven-install-plugin>
    <plugin.version.maven-jar-plugin>3.3.0</plugin.version.maven-jar-plugin>
    <plugin.version.maven-resources-plugin>3.3.1</plugin.version.maven-resources-plugin>
    <plugin.version.maven-shade-plugin>3.5.2</plugin.version.maven-shade-plugin>
    <plugin.version.maven-surefire-plugin>3.2.5</plugin.version.maven-surefire-plugin>
  </properties>

  <!-- Push the library to Maven -->
  <!-- Visit https://github.com/camunda-community-hub/community-action-maven-release -->
  <parent>
    <groupId>org.camunda.community</groupId>
    <artifactId>community-hub-release-parent</artifactId>
    <version>1.4.4</version>
  </parent>


  <dependencies>


    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${version.jackson}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
      <version>3.1.0</version>
    </dependency>


    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${version.slf4j}</version>
    </dependency>

    <!-- Camunda 8 Java client, used to call the Camunda 8 Identity component (user management) -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-core</artifactId>
      <version>${version.connector}</version>
      <!--<scope>provided</scope>  -->
    </dependency>
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-runtime-core</artifactId>
      <version>${version.connector}</version>
    </dependency>


    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>element-template-generator-core</artifactId>
      <version>${version.connector}</version>
    </dependency>



    <!-- test dependencies -->
    <!-- to generate the element-template -->
    <dependency>
      <groupId>io.camunda.community</groupId>
      <artifactId>zeebe-cherry-runtime</artifactId>
      <version>3.5.2</version>
      <scope>test</scope>
      <exclusions>
        <!-- zeebe-cherry-runtime drags in an entire old (Camunda 8.8.7-era) dependency graph -
             old Spring Boot, Micrometer, gRPC/Netty, Jackson, etc. Being declared before
             spring-boot-starter-camunda-connectors below, those old versions kept winning Maven's
             same-depth tie-break one at a time (NoClassDefFoundError on
             MeteredCamundaClientExecutorService, then FeelEngineWrapper, then a Micrometer/JVM
             metrics class...). LocalConnectorRuntime is a plain @SpringBootApplication that never
             touches zeebe-cherry-runtime's own runtime classes - it only needs this dependency for
             a few generator classes (see ElementTemplateGenerator/DocumentationGenerator), which
             compile fine against the versions declared explicitly above - so exclude everything
             transitive instead of chasing conflicts one by one. -->
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${version.junit-jupiter}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${version.mockito}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${version.assertj}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${version.slf4j}</version>
      <scope>test</scope>
    </dependency>

    <!-- for testing connectors locally in bundle with runtime -->

    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>spring-boot-starter-camunda-connectors</artifactId>
      <version>${version.connector}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

  </dependencies>


  <build>
    <!-- Enable @project.version@ (and other Maven property) filtering in test resources,
         e.g. src/test/resources/banner.txt uses @project.version@ -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${plugin.version.maven-clean-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${plugin.version.maven-dependency-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${plugin.version.maven-resources-plugin}</version>
          <executions>
            <execution>
              <id>copy-resources</id>
              <phase>install</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${basedir}/target/element-templates</outputDirectory>
                <resources>
                  <resource>
                    <directory>element-templates</directory>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.version.maven-compiler-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${plugin.version.maven-jar-plugin}</version>
          <configuration>
            <useDefaultManifestFile>false</useDefaultManifestFile>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${plugin.version.maven-install-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${plugin.version.maven-shade-plugin}</version>
          <configuration>
            <!-- no need for this since we are not consuming this artifact downstream -->
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <filters>
              <filter>
                <artifact>*:*</artifact>
                <excludes>
                  <exclude>module-info.class</exclude>
                  <exclude>META-INF/MANIFEST.MF</exclude>
                  <exclude>META-INF/*.SF</exclude>
                  <exclude>META-INF/*.DSA</exclude>
                  <exclude>META-INF/*.RSA</exclude>
                </excludes>
              </filter>
            </filters>
            <transformers>
              <!-- This is needed if you have dependencies that use Service Loader. Most Google Cloud client libraries does. -->
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              <!-- This is needed to not repeat licenses in the META-INF directory -->
              <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
              <!-- This is needed to merge existing NOTICE files and keep them downstream -->
              <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                <addHeader>false</addHeader>
              </transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer" />
            </transformers>
            <!-- Uncomment and adjust to use relocations inside your JAR -->
            <!--<relocations>
              <relocation>
                <pattern>com.fasterxml.jackson</pattern>
                <shadedPattern>myconnector.com.fasterxml.jackson</shadedPattern>
              </relocation>
            </relocations>-->
          </configuration>
          <executions>
            <!-- "with-dependencies": a convenience jar for local use (upload to a Connector Runtime
                 or Cherry instance by hand). Those hosts already provide Spring Boot + the whole
                 Camunda connector/client/FEEL stack (and their own transitive libraries below), so
                 this jar excludes all of that by groupId and bundles nothing but this project's own
                 classes by default. A future extra runtime dependency the host does NOT supply would
                 simply not appear in this exclude list, so it stays bundled normally.
                 shadedArtifactAttached MUST stay true here: with true, the shaded jar is attached as
                 a SEPARATE classified artifact and the main jar is left untouched; with false, Shade
                 instead REPLACES the main artifact's file with the fat jar (verified elsewhere: that
                 produced a bogus "original-*.jar" backup and a bloated main jar - the opposite of
                 what we want).
                 NOTE: a single blanket "*:*" exclude was tried first but also strips out this
                 project's OWN compiled classes (Shade treats an all-excluded artifact set as "make
                 an empty jar", not "keep only the project's own output") - excluding by explicit
                 groupId avoids that trap entirely.
                 No .github/workflows release pipeline exists in this project (unlike
                 camunda-8-connector-involvedusers), so there is no release profile to scope this
                 execution out of - it always runs on "mvn package"/"mvn install". -->
            <execution>
              <id>with-dependencies</id>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <shadedClassifierName>with-dependencies</shadedClassifierName>
                <shadedArtifactAttached>true</shadedArtifactAttached>
                <artifactSet>
                  <excludes>
                    <!-- Camunda connector/client/FEEL stack -->
                    <exclude>io.camunda.connector:*</exclude>
                    <exclude>io.camunda:*</exclude>
                    <exclude>org.camunda.feel:*</exclude>
                    <exclude>org.camunda.bpm.model:*</exclude>
                    <!-- Spring Boot / Spring Framework -->
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework:*</exclude>
                    <exclude>ch.qos.logback:*</exclude>
                    <exclude>org.apache.logging.log4j:*</exclude>
                    <exclude>org.slf4j:*</exclude>
                    <exclude>org.apache.tomcat.embed:*</exclude>
                    <exclude>io.micrometer:*</exclude>
                    <exclude>org.hdrhistogram:*</exclude>
                    <exclude>org.latencyutils:*</exclude>
                    <exclude>org.hibernate.validator:*</exclude>
                    <exclude>org.jboss.logging:*</exclude>
                    <exclude>com.fasterxml:classmate</exclude>
                    <exclude>org.yaml:*</exclude>
                    <!-- gRPC / Netty (Zeebe gateway transport) -->
                    <exclude>io.grpc:*</exclude>
                    <exclude>io.netty:*</exclude>
                    <exclude>io.opencensus:*</exclude>
                    <exclude>io.perfmark:*</exclude>
                    <exclude>com.google.protobuf:*</exclude>
                    <exclude>com.google.api.grpc:*</exclude>
                    <exclude>com.google.android:*</exclude>
                    <!-- HTTP clients -->
                    <exclude>org.apache.httpcomponents:*</exclude>
                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                    <exclude>org.apache.httpcomponents.core5:*</exclude>
                    <exclude>com.google.http-client:*</exclude>
                    <exclude>commons-codec:*</exclude>
                    <!-- Jackson -->
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                    <exclude>com.fasterxml.jackson.datatype:*</exclude>
                    <exclude>com.fasterxml.jackson.module:*</exclude>
                    <exclude>com.fasterxml.uuid:*</exclude>
                    <exclude>tools.jackson.core:*</exclude>
                    <!-- Scala (FEEL engine) -->
                    <exclude>org.scala-lang:*</exclude>
                    <exclude>com.lihaoyi:*</exclude>
                    <!-- Misc transitive libraries -->
                    <exclude>com.auth0:*</exclude>
                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                    <exclude>com.google.code.findbugs:*</exclude>
                    <exclude>com.google.code.gson:*</exclude>
                    <exclude>com.google.errorprone:*</exclude>
                    <exclude>com.google.guava:*</exclude>
                    <exclude>com.google.j2objc:*</exclude>
                    <exclude>com.thoughtworks.paranamer:*</exclude>
                    <exclude>dev.failsafe:*</exclude>
                    <exclude>jakarta.annotation:*</exclude>
                    <exclude>jakarta.validation:*</exclude>
                    <exclude>io.pebbletemplates:*</exclude>
                    <exclude>net.steppschuh.markdowngenerator:*</exclude>
                    <exclude>org.apache.commons:*</exclude>
                    <exclude>org.bouncycastle:*</exclude>
                    <exclude>org.checkerframework:*</exclude>
                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                    <exclude>org.jspecify:*</exclude>
                    <exclude>org.unbescape:*</exclude>
                    <exclude>uk.co.jemos.podam:*</exclude>
                    <!-- JAX-RS API and the SSL-context-kickstart libraries (published under
                         io.github.hakky54, but their classes are still packaged as nl.altindag.ssl.*)
                         are transitively dragged in by connector-runtime-core/http-client, which is
                         already excluded above by groupId - but Shade's artifactSet excludes only
                         remove each artifact by its OWN groupId:artifactId, not whatever further
                         transitive dependencies an excluded artifact pulls in under a different
                         groupId. Both are already on the host Connector Runtime's classpath. -->
                    <exclude>jakarta.ws.rs:*</exclude>
                    <exclude>io.github.hakky54:*</exclude>
                  </excludes>
                </artifactSet>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.version.maven-surefire-plugin}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>connectors</id>
      <name>Connectors Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors/</url>
    </repository>

    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>connectors-snapshots</id>
      <name>Connectors Snapshot Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
    </repository>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>camunda-community</id>
      <name>Camunda Community</name>
      <url>https://artifacts.camunda.com/artifactory/camunda-bpm-community-extensions/</url>
    </repository>

  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>connectors</id>
      <name>Connectors Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors/</url>
    </pluginRepository>

    <pluginRepository>
      <id>connectors-snapshots</id>
      <name>Connectors Snapshot Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
    </pluginRepository>
  </pluginRepositories>

    <profiles>
        <!-- Used by .github/workflows/deploy-artifactory-camunda.yml ("mvn -P deploy-jfrog deploy")
             to publish directly to this project's own JFrog Artifactory repo - and ONLY there, never
             to Maven Central. The parent (community-hub-release-parent) hard-codes maven-deploy-plugin
             to skip=true everywhere (both in pluginManagement and on the inherited, unconditional
             "default-deploy" execution bound in its own <build>), because it expects releases to go
             out exclusively through its own community-action-maven-release GitHub Action (which
             deploys to Maven Central via the Sonatype Central Portal/nexus-staging-maven-plugin, not
             via plain "mvn deploy" - see the community-action-maven-release profile below and
             deploy.yml). This profile re-enables maven-deploy-plugin, scoped to this profile only, so
             a plain "mvn deploy" without this profile (e.g. from deploy.yml, or a local "mvn deploy")
             stays a no-op, matching upstream's intent. It deploys to the "camunda-nexus" repository
             already declared in distributionManagement (inherited from the parent) - JFrog Artifactory
             at https://artifacts.camunda.com/artifactory/camunda-bpm-community-extensions/ - which
             requires a <server id="camunda-nexus"> entry in settings.xml with valid credentials. -->
        <profile>
            <id>deploy-jfrog</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>default-deploy</id>
                                <phase>deploy</phase>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- This project has no .github/workflows release pipeline today, so this profile is never
             activated automatically. It's added anyway so that if/when a release pipeline is added
             using the standard community-action-maven-release action (its default release-profile
             id - see involvedusers' deploy.yml for the working reference), the with-dependencies
             shade execution is already correctly scoped out of the Central release from day one. -->
        <profile>
            <id>community-action-maven-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>with-dependencies</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
